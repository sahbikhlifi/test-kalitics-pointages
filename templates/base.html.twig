<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Pointages{% endblock %} · Test Kalitics</title>
        <link
                rel="icon"
                href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%23ff441b%22/><path d=%22M16 8v8l5 3%22 stroke=%22white%22 stroke-width=%223%22 fill=%22none%22 stroke-linecap=%22round%22/></svg>"
        >
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/app.css') }}">
        {% endblock %}

        {% block javascripts %}{% endblock %}
    </head>
    <body>
        {% set route = app.request.attributes.get('_route') ?? '' %}
        <div class="app">
            <header class="topbar">
                <div class="topbar__inner">
                    <a class="brand" href="{{ path('app_Clocking_list') }}">
                        <span class="brand__mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        </span>
                        Pointages
                    </a>
                    <nav class="main-nav" aria-label="Navigation principale">
                        <ul>
                            <li>
                                <a href="{{ path('app_Clocking_list') }}" {{ route starts with 'app_Clocking' ? 'aria-current="page"' }}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
                                    Pointages
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_Project_list') }}" {{ route starts with 'app_Project' ? 'aria-current="page"' }}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V10l7-5 7 5v11M10 21v-6h4v6"/></svg>
                                    Chantiers
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_User_list') }}" {{ route starts with 'app_User' ? 'aria-current="page"' }}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-6 7-6s7 2 7 6M16 4a4 4 0 0 1 0 8M22 21c0-3-1.5-5-4-5.7"/></svg>
                                    Collaborateurs
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_home') }}" {{ route == 'app_home' ? 'aria-current="page"' }}>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
                                    À propos
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </header>

            <main class="main">
                <div class="page">
                    {% for message in app.flashes('success') %}
                        <div class="flash-success" role="status">{{ message }}</div>
                    {% endfor %}
                    {% block body %}{% endblock %}
                </div>
            </main>
        </div>
    </body>
</html>
